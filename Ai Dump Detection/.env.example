# Email Notification Settings (Optional)
# Set to 'true' to enable SMTP notifications for suspected illegal dumping incidents
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_RECIPIENT=alerts_recipient@smartcity.org
SMTP_USE_TLS=true

# Camera Configuration
CAMERA_INDEX=0

# Evidence Storage Policy (Retention in days)
EVIDENCE_RETENTION_DAYS=30

